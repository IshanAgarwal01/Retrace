# Copy this file to .env and fill in real values. Never commit .env.

# Carmen -> Calendar -> Calendar Feed
CARMEN_FEED_URL=

# aistudio.google.com -> Get API key (free, no card)
GEMINI_API_KEY=

# Any long random string; the app and Siri send it in the X-API-Key header.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
RETRACE_API_KEY=

# The secret ntfy.sh topic your iPhone's ntfy app subscribes to. Treat it like a
# password: anyone who knows it can read your notifications. Generate one the same way.
# Leave empty to turn notifications off.
NTFY_TOPIC=

# Optional. Leave unset on your laptop to use a local SQLite file (server/retrace.db).
# Hosted, set it to your Neon connection string (postgresql://...).
# DATABASE_URL=
